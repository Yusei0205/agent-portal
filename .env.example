# Copy to .env and adjust. Everything else is set in the portal under Settings.

# Where the portal listens. Use 0.0.0.0 only behind HTTPS (see README).
HOST=127.0.0.1
PORT=8787

# Database, project folders and clones live here. Back it up.
DATA_DIR=./data

# Optional absolute path to the native Codex executable (or the official npm codex.js launcher).
# Windows desktop installations are also discovered under LOCALAPPDATA automatically.
# PORTAL_CODEX_BIN=C:\Users\you\AppData\Local\Programs\OpenAI\Codex\bin\codex.exe
# Lambda uses the dedicated Codex AgentCore runner plus registered ChatGPT-plan OAuth.
# PORTAL_CODEX_AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:ap-southeast-1:123456789012:runtime/your_runtime
# PORTAL_CODEX_OAUTH_CLIENT_ID=oaiapp_your_registered_client
# PORTAL_CODEX_OAUTH_REDIRECT_URI=https://your-portal.example/api/codex/oauth/callback
# PORTAL_CODEX_OAUTH_CLIENT_AUTH=none
# For confidential clients use client_secret_basic and keep the secret in Secrets Manager:
# PORTAL_CODEX_OAUTH_CLIENT_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:your-secret

# Encrypts stored API keys and tokens. Generate with: openssl rand -hex 32
# Keep it safe: without it, saved secrets cannot be read.
PORTAL_SECRET_KEY=

# Optional: create the first admin account on start instead of using the setup page.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Admin

# Set to 1 when running behind a reverse proxy (Caddy, nginx, ALB) that sets X-Forwarded-*.
TRUST_PROXY=0

# Largest upload in MB.
MAX_UPLOAD_MB=50

# Speed of the simulated agent in Demo mode: 1 = realistic pauses, 0 = instant.
DEMO_SPEED=1

# Browser MCP server URL (set automatically by compose.yml when --profile browser is active).
# When unset, the browser tool pack reports "not configured" and the browser checkbox is disabled.
# PORTAL_BROWSER_MCP_URL=http://browser:8931/mcp
