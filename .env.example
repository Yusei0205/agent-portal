# Copy to .env and adjust. Everything else is set in the portal under Settings.

# Where the portal listens. Use 0.0.0.0 only behind HTTPS (see README).
HOST=127.0.0.1
PORT=8787

# Database, project folders and clones live here. Back it up.
DATA_DIR=./data

# Encrypts stored API keys and tokens. Generate with: openssl rand -hex 32
# Keep it safe: without it, saved secrets cannot be read.
PORTAL_SECRET_KEY=

# Optional: create the first admin account on start instead of using the setup page.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Admin

# Set to 1 when running behind a reverse proxy (Caddy, nginx, ALB) that sets X-Forwarded-*.
TRUST_PROXY=0

# Largest upload in MB.
MAX_UPLOAD_MB=50

# Speed of the simulated agent in Demo mode: 1 = realistic pauses, 0 = instant.
DEMO_SPEED=1

# Browser MCP server URL (set automatically by compose.yml when --profile browser is active).
# When unset, the browser tool pack reports "not configured" and the browser checkbox is disabled.
# PORTAL_BROWSER_MCP_URL=http://browser:8931/mcp

# Optional: send Anthropic API calls through an LLM gateway or proxy instead of api.anthropic.com.
# PORTAL_ANTHROPIC_BASE_URL=https://llm-gateway.example.com/anthropic

# Keep the model's credentials from agents' shell commands (CLAUDE_CODE_SUBPROCESS_ENV_SCRUB). On by default on Windows.
# On Linux and macOS Claude Code then runs every command in its sandbox (bubblewrap and socat, no network), so it is
# off there until the sandbox is set up. 1 = on, 0 = off.
# PORTAL_AGENT_ENV_SCRUB=1
