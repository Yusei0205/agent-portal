{
  "name": "agent-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted portal for Claude agents: projects, knowledge base, live agent runs, code review, role-based agents and skills, and learning content.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs --web-only",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/server.mjs",
    "dev": "node scripts/build.mjs --web-only && node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-timeout=300000 test/*.test.ts",
    "test:file": "node --disable-warning=ExperimentalWarning --import tsx --test --test-timeout=300000",
    "test:affected": "node scripts/test-affected.mjs",
    "test:map:check": "node scripts/test-map-check.mjs",
    "test:checklist": "node scripts/test-checklist.mjs",
    "test:repo-contracts": "node scripts/test-affected.mjs --backend-only --module api-tokens && node scripts/test-affected.mjs --backend-only --module auth && node scripts/test-affected.mjs --backend-only --module projects && node scripts/test-affected.mjs --backend-only --module permissions && node scripts/test-affected.mjs --backend-only --module audit && node scripts/test-affected.mjs --backend-only --module delegation && node scripts/test-affected.mjs --backend-only --module settings && node scripts/test-affected.mjs --backend-only --module sessions && node scripts/test-affected.mjs --backend-only --module inbox && node scripts/test-affected.mjs --backend-only --module budget",
    "test:ui": "node scripts/build.mjs && node --disable-warning=ExperimentalWarning --import tsx test/ui/smoke.ts",
    "test:ui:fast": "node --disable-warning=ExperimentalWarning --import tsx test/ui/smoke.ts",
    "test:ui:commands": "node scripts/build.mjs && node --disable-warning=ExperimentalWarning --import tsx test/ui/slash-commands.ts",
    "test:container": "node scripts/container-smoke.mjs",
    "screenshots": "node --disable-warning=ExperimentalWarning --import tsx test/ui/take-screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.303",
    "@aws-sdk/client-bedrock": "3.1152.0",
    "@aws-sdk/client-bedrock-runtime": "3.1152.0",
    "@aws-sdk/client-codecommit": "3.1152.0",
    "@aws-sdk/client-sso": "3.1152.0",
    "@aws-sdk/client-sso-oidc": "3.1152.0",
    "@aws-sdk/credential-providers": "3.1152.0",
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/quicksand": "5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.1",
    "docx": "9.5.0",
    "dompurify": "^3.4.0",
    "exceljs": "4.4.0",
    "jszip": "^3.10.1",
    "marked": "^18.0.0",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^6.2.0",
    "pptxgenjs": "4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "3.10.1",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/ws": "8.5.14",
    "esbuild": "^0.28.0",
    "jsdom": "^25.0.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.56.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0"
  }
}
