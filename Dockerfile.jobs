# Agent Portal job runtime (AgentCore Runtime): the same server as Dockerfile.lambda, started as the runtime for long
# background jobs. AgentCore runs arm64 containers and calls POST /invocations and GET /ping on port 8080.
# Build from the repo root: docker buildx build --platform linux/arm64 -f Dockerfile.jobs -t agent-portal-jobs .
# The CDK stack builds and deploys it when the portal is deployed with -c jobRuntime=true (see server/job-runtime.ts).
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build
RUN ICON_DIAGRAMS_DIR=/opt/icon-diagrams node --disable-warning=ExperimentalWarning --import tsx scripts/install-drawio-pack.ts
RUN npm prune --omit=dev

FROM node:22-bookworm-slim
# What the jobs need, as in the Lambda image: git for repositories, a headless browser for diagrams and test runs.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates chromium fonts-liberation fonts-noto-color-emoji \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./
COPY --from=build /opt/icon-diagrams /opt/icon-diagrams
# Local data and HOME live under /tmp, as on Lambda (durable files go to S3). PORTAL_JOB_RUNNER turns on /invocations and
# /ping and keeps the schedules (idle stop, cleanup) on the portal function only.
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080 DATA_DIR=/tmp/data HOME=/tmp/home ICON_DIAGRAMS_DIR=/opt/icon-diagrams DOC_BROWSER=/usr/bin/chromium \
    USE_DYNAMODB=true PORTAL_JOB_RUNNER=1
EXPOSE 8080
CMD ["node", "--disable-warning=ExperimentalWarning", "dist/server.mjs"]
