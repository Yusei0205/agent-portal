# Agent Portal on Lambda (Path B): same server, run behind Lambda Web Adapter with response streaming.
# Build from the repo root: docker build -f Dockerfile.lambda -t agent-portal-lambda .
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build
# The Icon diagrams (draw.io) pack is installed while the image is built (pinned and checked by hash), so it ships in the
# image instead of being fetched from S3 file by file when an instance starts.
RUN ICON_DIAGRAMS_DIR=/opt/icon-diagrams node --disable-warning=ExperimentalWarning --import tsx scripts/install-drawio-pack.ts
RUN npm prune --omit=dev

FROM node:22-bookworm-slim
# git for repository features. The other Docker-image tools (pandoc, python-pptx, ...) are not in the core cloud version.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
# A headless browser for what the portal draws and runs itself: diagram and slide previews (Mermaid, draw.io) and the
# Tests module (Playwright). /usr/bin/chromium is where the server looks for it.
RUN apt-get update && apt-get install -y --no-install-recommends chromium fonts-liberation fonts-noto-color-emoji && rm -rf /var/lib/apt/lists/*
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./
COPY --from=build /opt/icon-diagrams /opt/icon-diagrams
# Lambda is read-only except /tmp, so local data and HOME live there (not persistent: files move to S3 in step 2).
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8787 DATA_DIR=/tmp/data HOME=/tmp/home ICON_DIAGRAMS_DIR=/opt/icon-diagrams DOC_BROWSER=/usr/bin/chromium \
    USE_DYNAMODB=true \
    AWS_LWA_PORT=8787 AWS_LWA_INVOKE_MODE=response_stream AWS_LWA_READINESS_CHECK_PATH=/api/health
CMD ["node", "--disable-warning=ExperimentalWarning", "dist/server.mjs"]
